hf_curl() { if [ -n "${HF_TOKEN:-}" ]; then _llmkube_tok=$(printf '%s' "$HF_TOKEN"); case "$_llmkube_tok" in *'"'*|*'\'*|*[![:print:]]*) echo "ERROR: HF_TOKEN contains a character curl config cannot carry" >&2; return 1;; esac; printf 'header = "Authorization: Bearer %s"\n' "$_llmkube_tok" | curl -K - "$@"; else curl "$@"; fi; } && download_with_progress() { _llmkube_dest="$1"; _llmkube_total="${2:-}"; shift 2; "$@" & _llmkube_pid=$!; _llmkube_elapsed=0; while kill -0 "$_llmkube_pid" 2>/dev/null; do sleep 1; kill -0 "$_llmkube_pid" 2>/dev/null || break; _llmkube_elapsed=$((_llmkube_elapsed + 1)); [ $((_llmkube_elapsed % ${PROGRESS_INTERVAL:-10})) -eq 0 ] || continue; _llmkube_have=$(stat -c %s "$_llmkube_dest" 2>/dev/null || echo 0); if [ -n "$_llmkube_total" ] && [ "$_llmkube_total" -gt 0 ] 2>/dev/null; then echo "Downloaded $((_llmkube_have / 1048576)) MiB of $((_llmkube_total / 1048576)) MiB ($((_llmkube_have * 100 / _llmkube_total))%)"; else echo "Downloaded $((_llmkube_have / 1048576)) MiB"; fi; done; wait "$_llmkube_pid"; } && echo 'Revalidating model against upstream (RefreshPolicy=OnChange)...'; remote_head=$(hf_curl -fsSL -I "$MODEL_SOURCE" -o /dev/null -w 'CL%header{content-length}ET%header{etag}\n%header{accept-ranges}' 2>/dev/null || echo 'CL0ET'); remote_validator=$(printf '%s\n' "$remote_head" | sed -n 1p); accept_ranges=$(printf '%s\n' "$remote_head" | sed -n 2p); remote_size=${remote_validator#CL}; remote_size=${remote_size%%ET*}; if [ -f "$MODEL_PATH" ] && [ "$(stat -c %s "$MODEL_PATH" 2>/dev/null || echo 0)" = "$remote_size" ] && [ "$remote_size" != "0" ]; then echo 'Model revalidated (unchanged, skipped download)'; else key=$(printf '%s' "$remote_validator" | sha256sum | cut -c1-12); MODEL_PARTIAL="$MODEL_PATH.$key.tmp"; find "$(dirname "$MODEL_PATH")" -maxdepth 1 -name '*.tmp' ! -name "$(basename "$MODEL_PARTIAL")" -delete; [ "$accept_ranges" = bytes ] || rm -f "$MODEL_PARTIAL"; if download_with_progress "$MODEL_PARTIAL" "$remote_size" hf_curl -fsSL -C - -o "$MODEL_PARTIAL" "$MODEL_SOURCE" --no-progress-meter && case "$remote_size" in ''|0) ;; *) if [ "$(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0)" != "$remote_size" ]; then echo "ERROR: $MODEL_PARTIAL is $(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0) bytes but the origin advertised $remote_size; discarded it" >&2; rm -f "$MODEL_PARTIAL"; false; fi;; esac && mv "$MODEL_PARTIAL" "$MODEL_PATH"; then echo 'Model revalidated (downloaded)'; elif [ -f "$MODEL_PATH" ]; then echo 'Revalidation unreachable; kept cached copy'; exit 0; else echo 'ERROR: model missing and revalidation failed'; exit 1; fi; fi