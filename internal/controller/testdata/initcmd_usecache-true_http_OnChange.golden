cache_fs=$(stat -f -c %t "$CACHE_DIR" 2>/dev/null || stat -f -c %t "$(dirname "$CACHE_DIR")") || { echo "WARNING: cannot determine the cache filesystem: this init image's stat has no -f; staging under the directory lock, which does not exclude pods on other nodes on a FUSE cache" >&2; cache_fs=unknown; }; llmkube_fuse_reader() { [ "$cache_fs" = 65735546 ] && [ "${LLMKUBE_PREFETCH_STAGER:-false}" != true ]; }; llmkube_stage_allowed() { if llmkube_fuse_reader; then echo "ERROR: ModelCacheLockUnsupported: FUSE cache cannot guarantee cross-node file locking for staging $1; set spec.modelCache.prefetch: true on every InferenceService using this claim, or use storage with cross-node flock support" >&2; return 1; fi; }; if [ "$cache_fs" != 65735546 ]; then mkdir -p "$CACHE_DIR" || exit 1; if [ -w "$CACHE_DIR" ]; then command -v flock >/dev/null 2>&1 || { echo "ERROR: the init image must provide flock to lock $CACHE_DIR" >&2; exit 1; }; command exec 9>"$CACHE_DIR/.llmkube-download.lock" || { echo "ERROR: could not open $CACHE_DIR/.llmkube-download.lock" >&2; exit 1; }; if ! flock -n 9; then echo 'Waiting for the download lock held by another pod...'; flock 9 || { echo "ERROR: could not lock $CACHE_DIR/.llmkube-download.lock; the cache volume must support file locking (NFS needs a lock daemon)" >&2; exit 1; }; fi; else echo "WARNING: $CACHE_DIR is not writable by uid $(id -u); skipping the download lock" >&2; fi; find "$CACHE_DIR" -type f \( -name '*.llmkube-tmp.??????' -o -name '*.llmkube-size.??????' -o -name '*.sha256-rejected.??????' \) -mmin +10 -delete 2>/dev/null; elif [ "${LLMKUBE_PREFETCH_STAGER:-false}" = true ]; then mkdir -p "$CACHE_DIR" || exit 1; find "$CACHE_DIR" -type f \( -name '*.llmkube-tmp.??????' -o -name '*.llmkube-size.??????' -o -name '*.sha256-rejected.??????' \) -mmin +10 -delete 2>/dev/null; fi; { llmkube_fuse_reader || find "$(dirname "$MODEL_PATH")" -maxdepth 1 -name '*.tmp' -delete; } && download_with_progress() { _llmkube_dest="$1"; _llmkube_total="${2:-}"; shift 2; "$@" & _llmkube_pid=$!; _llmkube_elapsed=0; while kill -0 "$_llmkube_pid" 2>/dev/null; do sleep 1; kill -0 "$_llmkube_pid" 2>/dev/null || break; _llmkube_elapsed=$((_llmkube_elapsed + 1)); [ $((_llmkube_elapsed % ${PROGRESS_INTERVAL:-10})) -eq 0 ] || continue; _llmkube_have=$(stat -c %s "$_llmkube_dest" 2>/dev/null || echo 0); if [ -n "$_llmkube_total" ] && [ "$_llmkube_total" -gt 0 ] 2>/dev/null; then echo "Downloaded $((_llmkube_have / 1048576)) MiB of $((_llmkube_total / 1048576)) MiB ($((_llmkube_have * 100 / _llmkube_total))%)"; else echo "Downloaded $((_llmkube_have / 1048576)) MiB"; fi; done; wait "$_llmkube_pid"; } && echo 'Revalidating model against upstream (RefreshPolicy=OnChange)...'; remote_head=$(curl -fsSL -I "$MODEL_SOURCE" -o /dev/null -w 'CL%header{content-length}ET%header{etag}\n%header{accept-ranges}' 2>/dev/null || echo 'CL0ET'); remote_validator=$(printf '%s\n' "$remote_head" | sed -n 1p); accept_ranges=$(printf '%s\n' "$remote_head" | sed -n 2p); remote_size=${remote_validator#CL}; remote_size=${remote_size%%ET*}; if [ -f "$MODEL_PATH" ] && [ "$(stat -c %s "$MODEL_PATH" 2>/dev/null || echo 0)" = "$remote_size" ] && [ "$remote_size" != "0" ]; then echo 'Model revalidated (unchanged, skipped download)'; else if llmkube_fuse_reader; then if [ -f "$MODEL_PATH" ]; then case "$remote_size" in ''|0) echo "Revalidation unreachable for ${MODEL_PATH##*/}; kept cached copy";; *) echo "Upstream changed for ${MODEL_PATH##*/}; a serving pod does not stage on a FUSE cache, so it kept the cached copy";; esac; else llmkube_stage_allowed "${MODEL_PATH##*/}"; exit 1; fi; else key=$(printf '%s' "$remote_validator" | sha256sum | cut -c1-12); MODEL_PARTIAL="$MODEL_PATH.$key.tmp"; find "$(dirname "$MODEL_PATH")" -maxdepth 1 -name '*.tmp' ! -name "$(basename "$MODEL_PARTIAL")" -delete; [ "$accept_ranges" = bytes ] || rm -f "$MODEL_PARTIAL"; if download_with_progress "$MODEL_PARTIAL" "$remote_size" curl -fsSL -C - -o "$MODEL_PARTIAL" "$MODEL_SOURCE" --no-progress-meter && case "$remote_size" in ''|0) ;; *) if [ "$(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0)" != "$remote_size" ]; then echo "ERROR: $MODEL_PARTIAL is $(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0) bytes but the origin advertised $remote_size; discarded it" >&2; rm -f "$MODEL_PARTIAL"; false; fi;; esac && mv "$MODEL_PARTIAL" "$MODEL_PATH"; then echo 'Model revalidated (downloaded)'; elif [ -f "$MODEL_PATH" ]; then echo 'Revalidation unreachable; kept cached copy'; exit 0; else echo 'ERROR: model missing and revalidation failed'; exit 1; fi; fi; fi