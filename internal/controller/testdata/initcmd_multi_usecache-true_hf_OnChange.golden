llmkube_atomic_write() { _llmkube_tmp=$(mktemp "$1.llmkube-tmp.XXXXXX") || return 1; if printf '%s' "$2" > "$_llmkube_tmp" && mv "$_llmkube_tmp" "$1"; then return 0; fi; rm -f "$_llmkube_tmp"; return 1; }; download_with_progress() { _llmkube_dest="$1"; _llmkube_total="${2:-}"; shift 2; "$@" & _llmkube_pid=$!; _llmkube_elapsed=0; while kill -0 "$_llmkube_pid" 2>/dev/null; do sleep 1; kill -0 "$_llmkube_pid" 2>/dev/null || break; _llmkube_elapsed=$((_llmkube_elapsed + 1)); [ $((_llmkube_elapsed % ${PROGRESS_INTERVAL:-10})) -eq 0 ] || continue; _llmkube_have=$(stat -c %s "$_llmkube_dest" 2>/dev/null || echo 0); if [ -n "$_llmkube_total" ] && [ "$_llmkube_total" -gt 0 ] 2>/dev/null; then echo "Downloaded $((_llmkube_have / 1048576)) MiB of $((_llmkube_total / 1048576)) MiB ($((_llmkube_have * 100 / _llmkube_total))%)"; else echo "Downloaded $((_llmkube_have / 1048576)) MiB"; fi; done; wait "$_llmkube_pid"; } && cache_fs=$(stat -f -c %t "$CACHE_DIR" 2>/dev/null || stat -f -c %t "$(dirname "$CACHE_DIR")") || { echo "WARNING: cannot determine the cache filesystem: this init image's stat has no -f; staging under the directory lock, which does not exclude pods on other nodes on a FUSE cache" >&2; cache_fs=unknown; }; llmkube_fuse_reader() { [ "$cache_fs" = 65735546 ] && [ "${LLMKUBE_PREFETCH_STAGER:-false}" != true ]; }; llmkube_stage_allowed() { if llmkube_fuse_reader; then echo "ERROR: ModelCacheLockUnsupported: FUSE cache cannot guarantee cross-node file locking for staging $1; set spec.modelCache.prefetch: true on every InferenceService using this claim, or use storage with cross-node flock support" >&2; return 1; fi; }; if [ "$cache_fs" != 65735546 ]; then mkdir -p "$CACHE_DIR" || exit 1; if [ -w "$CACHE_DIR" ]; then command -v flock >/dev/null 2>&1 || { echo "ERROR: the init image must provide flock to lock $CACHE_DIR" >&2; exit 1; }; command exec 9>"$CACHE_DIR/.llmkube-download.lock" || { echo "ERROR: could not open $CACHE_DIR/.llmkube-download.lock" >&2; exit 1; }; if ! flock -n 9; then echo 'Waiting for the download lock held by another pod...'; flock 9 || { echo "ERROR: could not lock $CACHE_DIR/.llmkube-download.lock; the cache volume must support file locking (NFS needs a lock daemon)" >&2; exit 1; }; fi; else echo "WARNING: $CACHE_DIR is not writable by uid $(id -u); skipping the download lock" >&2; fi; find "$CACHE_DIR" -type f \( -name '*.llmkube-tmp.??????' -o -name '*.llmkube-size.??????' -o -name '*.sha256-rejected.??????' \) -mmin +10 -delete 2>/dev/null; elif [ "${LLMKUBE_PREFETCH_STAGER:-false}" = true ]; then mkdir -p "$CACHE_DIR" || exit 1; find "$CACHE_DIR" -type f \( -name '*.llmkube-tmp.??????' -o -name '*.llmkube-size.??????' -o -name '*.sha256-rejected.??????' \) -mmin +10 -delete 2>/dev/null; fi; llmkube_prepare_download() { llmkube_stage_allowed "$rel" || return 1; mkdir -p "$(dirname "$dest")"; }; llmkube_cached_size_matches() { _llmkube_local_size=$(stat -c %s "$dest" 2>/dev/null) || return 1; if [ -f "$dest.llmkube-size" ]; then _llmkube_size=$(cat "$dest.llmkube-size" 2>/dev/null); case "$_llmkube_size" in ''|*[!0-9]*) ;; *) [ "$_llmkube_local_size" = "$_llmkube_size" ]; return $?;; esac; fi; echo "WARNING: no valid size record for $rel; keeping cached copy without size validation" >&2; return 0; }; normalize_hf_source() { case "$1" in hf://*) src="${1#hf://}"; rev="${src#*@}"; if [ "$rev" != "$src" ]; then echo "https://huggingface.co/${src%%@*}/resolve/$rev/"; else echo "https://huggingface.co/$src/resolve/main/"; fi ;; *) echo "$1" ;; esac; } && hf_curl() { if [ -n "${HF_TOKEN:-}" ]; then _llmkube_tok=$(printf '%s' "$HF_TOKEN"); case "$_llmkube_tok" in *'"'*|*'\'*|*[![:print:]]*) echo "ERROR: HF_TOKEN contains a character curl config cannot carry" >&2; return 1;; esac; printf 'header = "Authorization: Bearer %s"\n' "$_llmkube_tok" | curl -K - "$@"; else curl "$@"; fi; } && SOURCE="$(normalize_hf_source "$MODEL_SOURCE")" && printf '%s\n' "$MODEL_FILES" | while IFS= read -r rel; do [ -n "$rel" ] || continue; dest="$CACHE_DIR/$rel"; url="${SOURCE%/}/$rel"; MODEL_PATH="$dest"; MODEL_SOURCE="$url"; remote_head=$(hf_curl -fsSL -I "$url" -o /dev/null -w 'CL%header{content-length}ET%header{etag}\n%header{accept-ranges}' 2>/dev/null) || remote_head='CLET'; remote_validator=$(printf '%s\n' "$remote_head" | sed -n 1p); accept_ranges=$(printf '%s\n' "$remote_head" | sed -n 2p); remote_size=${remote_validator#CL}; remote_size=${remote_size%%ET*}; if [ -f "$dest" ] && [ "$(stat -c %s "$dest" 2>/dev/null || echo 0)" = "$remote_size" ] && [ "$remote_size" != "0" ]; then echo "Model artifact $rel revalidated (unchanged, skipped download)"; else if llmkube_fuse_reader; then if [ -f "$dest" ] && llmkube_cached_size_matches; then case "$remote_size" in ''|0) echo "Revalidation unreachable for $rel; kept cached copy";; *) echo "Upstream changed for $rel; a serving pod does not stage on a FUSE cache, so it kept the cached copy";; esac; else llmkube_stage_allowed "$rel"; exit 1; fi; elif llmkube_prepare_download && { key=$(printf '%s' "$remote_validator" | sha256sum | cut -c1-12); MODEL_PARTIAL="$MODEL_PATH.$key.tmp"; find "$(dirname "$MODEL_PATH")" -maxdepth 1 -name '*.tmp' ! -name "$(basename "$MODEL_PARTIAL")" -delete; [ "$accept_ranges" = bytes ] || rm -f "$MODEL_PARTIAL"; download_with_progress "$MODEL_PARTIAL" "$remote_size" hf_curl -fsSL -C - -o "$MODEL_PARTIAL" "$url" --no-progress-meter && case "$remote_size" in ''|0) ;; *) if [ "$(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0)" != "$remote_size" ]; then echo "ERROR: $MODEL_PARTIAL is $(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0) bytes but the origin advertised $remote_size; discarded it" >&2; rm -f "$MODEL_PARTIAL"; false; fi;; esac && { published_size=$(stat -c %s "$MODEL_PARTIAL") && mv "$MODEL_PARTIAL" "$dest" && { [ "$(stat -c %s "$dest")" = "$published_size" ] || { rm -f "$dest" "$dest.sha256" "$dest.llmkube-size"; echo "ERROR: published artifact $rel has the wrong size" >&2; false; }; } && { llmkube_atomic_write "$dest.llmkube-size" "$published_size" || echo "WARNING: could not record staged size for $rel" >&2; }; }; }; then echo "Model artifact $rel revalidated (downloaded)"; elif [ -f "$dest" ] && llmkube_cached_size_matches; then echo "Revalidation unreachable for $rel; kept cached copy"; else echo "ERROR: model artifact $rel could not be validated or downloaded"; exit 1; fi; fi; done && if ! llmkube_fuse_reader; then find "$CACHE_DIR" -name '*.tmp' -delete; fi