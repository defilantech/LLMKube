llmkube_atomic_write() { _llmkube_tmp=$(mktemp "$1.llmkube-tmp.XXXXXX") || return 1; if printf '%s' "$2" > "$_llmkube_tmp" && mv "$_llmkube_tmp" "$1"; then return 0; fi; rm -f "$_llmkube_tmp"; return 1; }; s3_curl() { _llmkube_id=$(printf '%s' "${AWS_ACCESS_KEY_ID:-}"); _llmkube_key=$(printf '%s' "${AWS_SECRET_ACCESS_KEY:-}"); case "${_llmkube_id}${_llmkube_key}" in *'"'*|*'\'*|*[![:print:]]*) echo "ERROR: AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY contains a character curl config cannot carry" >&2; return 1;; esac; printf 'user = "%s:%s"\n' "$_llmkube_id" "$_llmkube_key" | curl --aws-sigv4 "aws:amz:${AWS_REGION}:s3" -K - "$@"; } && download_with_progress() { _llmkube_dest="$1"; _llmkube_total="${2:-}"; shift 2; "$@" & _llmkube_pid=$!; _llmkube_elapsed=0; while kill -0 "$_llmkube_pid" 2>/dev/null; do sleep 1; kill -0 "$_llmkube_pid" 2>/dev/null || break; _llmkube_elapsed=$((_llmkube_elapsed + 1)); [ $((_llmkube_elapsed % ${PROGRESS_INTERVAL:-10})) -eq 0 ] || continue; _llmkube_have=$(stat -c %s "$_llmkube_dest" 2>/dev/null || echo 0); if [ -n "$_llmkube_total" ] && [ "$_llmkube_total" -gt 0 ] 2>/dev/null; then echo "Downloaded $((_llmkube_have / 1048576)) MiB of $((_llmkube_total / 1048576)) MiB ($((_llmkube_have * 100 / _llmkube_total))%)"; else echo "Downloaded $((_llmkube_have / 1048576)) MiB"; fi; done; wait "$_llmkube_pid"; } && mkdir -p /models && llmkube_prepare_download() { mkdir -p "$(dirname "$dest")"; }; llmkube_cached_size_matches() { _llmkube_local_size=$(stat -c %s "$dest" 2>/dev/null) || return 1; if [ -f "$dest.llmkube-size" ]; then _llmkube_size=$(cat "$dest.llmkube-size" 2>/dev/null); case "$_llmkube_size" in ''|*[!0-9]*) ;; *) [ "$_llmkube_local_size" = "$_llmkube_size" ]; return $?;; esac; fi; echo "WARNING: no valid size record for $rel; keeping cached copy without size validation" >&2; return 0; }; find /models -name '*.tmp' -delete && normalize_hf_source() { case "$1" in hf://*) src="${1#hf://}"; rev="${src#*@}"; if [ "$rev" != "$src" ]; then echo "https://huggingface.co/${src%%@*}/resolve/$rev/"; else echo "https://huggingface.co/$src/resolve/main/"; fi ;; *) echo "$1" ;; esac; } && SOURCE="$(normalize_hf_source "$MODEL_SOURCE")" && printf '%s\n' "$MODEL_FILES" | while IFS= read -r rel; do [ -n "$rel" ] || continue; dest="$CACHE_DIR/$rel"; key="${S3_PREFIX:+${S3_PREFIX}/}$rel"; url="${AWS_ENDPOINT_URL}/${S3_BUCKET}/${key}"; remote_size=$(s3_curl -fsSL -I "$url" -o /dev/null -w '%header{content-length}' 2>/dev/null) || remote_size=; if [ -f "$dest" ] && [ "$(stat -c %s "$dest" 2>/dev/null || echo 0)" = "$remote_size" ] && [ "$remote_size" != "0" ]; then echo "Model artifact $rel revalidated (unchanged, skipped download)"; else if llmkube_prepare_download && download_with_progress "$dest.tmp" "" s3_curl -f -L -o "$dest.tmp" "$url" --no-progress-meter && { published_size=$(stat -c %s "$dest.tmp") && mv "$dest.tmp" "$dest" && { [ "$(stat -c %s "$dest")" = "$published_size" ] || { rm -f "$dest" "$dest.sha256" "$dest.llmkube-size"; echo "ERROR: published artifact $rel has the wrong size" >&2; false; }; } && { llmkube_atomic_write "$dest.llmkube-size" "$published_size" || echo "WARNING: could not record staged size for $rel" >&2; }; }; then echo "Model artifact $rel revalidated (downloaded)"; elif [ -f "$dest" ] && llmkube_cached_size_matches; then echo "Revalidation unreachable for $rel; kept cached copy"; else echo "ERROR: model artifact $rel could not be validated or downloaded"; exit 1; fi; fi; done