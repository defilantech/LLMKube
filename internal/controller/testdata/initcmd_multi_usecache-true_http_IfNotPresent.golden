download_with_progress() { _llmkube_dest="$1"; _llmkube_total="${2:-}"; shift 2; "$@" & _llmkube_pid=$!; _llmkube_elapsed=0; while kill -0 "$_llmkube_pid" 2>/dev/null; do sleep 1; kill -0 "$_llmkube_pid" 2>/dev/null || break; _llmkube_elapsed=$((_llmkube_elapsed + 1)); [ $((_llmkube_elapsed % ${PROGRESS_INTERVAL:-10})) -eq 0 ] || continue; _llmkube_have=$(stat -c %s "$_llmkube_dest" 2>/dev/null || echo 0); if [ -n "$_llmkube_total" ] && [ "$_llmkube_total" -gt 0 ] 2>/dev/null; then echo "Downloaded $((_llmkube_have / 1048576)) MiB of $((_llmkube_total / 1048576)) MiB ($((_llmkube_have * 100 / _llmkube_total))%)"; else echo "Downloaded $((_llmkube_have / 1048576)) MiB"; fi; done; wait "$_llmkube_pid"; } && cache_fs=$(stat -f -c %t "$CACHE_DIR" 2>/dev/null || stat -f -c %t "$(dirname "$CACHE_DIR")") || { echo "ERROR: ModelCacheLockUnsupported: cannot determine cache filesystem; use an init image with stat -f support" >&2; exit 1; }; if [ "$cache_fs" != 65735546 ]; then mkdir -p "$CACHE_DIR" || exit 1; if [ -w "$CACHE_DIR" ]; then command -v flock >/dev/null 2>&1 || { echo "ERROR: the init image must provide flock to lock $CACHE_DIR" >&2; exit 1; }; command exec 9>"$CACHE_DIR/.llmkube-download.lock" || { echo "ERROR: could not open $CACHE_DIR/.llmkube-download.lock" >&2; exit 1; }; if ! flock -n 9; then echo 'Waiting for the download lock held by another pod...'; flock 9 || { echo "ERROR: could not lock $CACHE_DIR/.llmkube-download.lock; the cache volume must support file locking (NFS needs a lock daemon)" >&2; exit 1; }; fi; else echo "WARNING: $CACHE_DIR is not writable by uid $(id -u); skipping the download lock" >&2; fi; elif [ "${LLMKUBE_PREFETCH_STAGER:-false}" = true ]; then mkdir -p "$CACHE_DIR" || exit 1; fi; llmkube_prepare_download() { if [ "$cache_fs" = 65735546 ] && [ "${LLMKUBE_PREFETCH_STAGER:-false}" != true ]; then echo "ERROR: ModelCacheLockUnsupported: FUSE cache cannot guarantee cross-node file locking for staging $rel; set spec.modelCache.prefetch: true on every InferenceService using this claim, or use storage with cross-node flock support" >&2; return 1; fi; mkdir -p "$(dirname "$dest")"; }; llmkube_cached_size_matches() { _llmkube_local_size=$(stat -c %s "$dest" 2>/dev/null) || return 1; if [ "$#" -eq 0 ] && [ -f "$dest.llmkube-size" ]; then _llmkube_size=$(cat "$dest.llmkube-size" 2>/dev/null); case "$_llmkube_size" in ''|*[!0-9]*) ;; *) [ "$_llmkube_local_size" = "$_llmkube_size" ]; return $?;; esac; fi; if [ "$#" -gt 0 ]; then _llmkube_size=$1; else _llmkube_size=$(curl -fsSL -I "$url" -o /dev/null -w '%header{content-length}' 2>/dev/null) || _llmkube_size=; fi; case "$_llmkube_size" in ''|*[!0-9]*) echo "WARNING: origin size unavailable for $rel; keeping cached copy without size validation" >&2; return 0;; esac; [ "$_llmkube_local_size" = "$_llmkube_size" ]; }; normalize_hf_source() { case "$1" in hf://*) src="${1#hf://}"; rev="${src#*@}"; if [ "$rev" != "$src" ]; then echo "https://huggingface.co/${src%%@*}/resolve/$rev/"; else echo "https://huggingface.co/$src/resolve/main/"; fi ;; *) echo "$1" ;; esac; } && SOURCE="$(normalize_hf_source "$MODEL_SOURCE")" && printf '%s\n' "$MODEL_FILES" | while IFS= read -r rel; do [ -n "$rel" ] || continue; dest="$CACHE_DIR/$rel"; url="${SOURCE%/}/$rel"; if [ -f "$dest" ] && llmkube_cached_size_matches; then echo "Model artifact $rel already cached, skipping download"; else llmkube_prepare_download || exit 1; echo "Downloading model artifact $rel..."; MODEL_PATH="$dest"; MODEL_SOURCE="$url"; remote_head=$(curl -fsSL -I "$MODEL_SOURCE" -o /dev/null -w 'CL%header{content-length}ET%header{etag}\n%header{accept-ranges}' 2>/dev/null || echo ''); remote_validator=$(printf '%s\n' "$remote_head" | sed -n 1p); accept_ranges=$(printf '%s\n' "$remote_head" | sed -n 2p); remote_size=${remote_validator#CL}; remote_size=${remote_size%%ET*}; key=$(printf '%s' "$remote_validator" | sha256sum | cut -c1-12); MODEL_PARTIAL="$MODEL_PATH.$key.tmp"; find "$(dirname "$MODEL_PATH")" -maxdepth 1 -name '*.tmp' ! -name "$(basename "$MODEL_PARTIAL")" -delete; [ "$accept_ranges" = bytes ] || rm -f "$MODEL_PARTIAL"; download_with_progress "$MODEL_PARTIAL" "$remote_size" curl -f -L -C - -o "$MODEL_PARTIAL" "$url" --no-progress-meter && case "$remote_size" in ''|0) ;; *) if [ "$(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0)" != "$remote_size" ]; then echo "ERROR: $MODEL_PARTIAL is $(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0) bytes but the origin advertised $remote_size; discarded it" >&2; rm -f "$MODEL_PARTIAL"; false; fi;; esac && { published_size=$(stat -c %s "$MODEL_PARTIAL") && mv "$MODEL_PARTIAL" "$dest" && { [ "$(stat -c %s "$dest")" = "$published_size" ] || { rm -f "$dest" "$dest.sha256" "$dest.llmkube-size"; echo "ERROR: published artifact $rel has the wrong size" >&2; false; }; } && { printf '%s\n' "$published_size" > "$dest.llmkube-size" || echo "WARNING: could not record staged size for $rel" >&2; }; } || { echo "ERROR: failed to download $rel"; exit 1; }; fi; done && if [ "$cache_fs" != 65735546 ] || [ "${LLMKUBE_PREFETCH_STAGER:-false}" = true ]; then find "$CACHE_DIR" -name '*.tmp' -delete; fi