llmkube_atomic_write() { _llmkube_tmp=$(mktemp "$1.llmkube-tmp.XXXXXX") || return 1; if printf '%s' "$2" > "$_llmkube_tmp" && mv "$_llmkube_tmp" "$1"; then return 0; fi; rm -f "$_llmkube_tmp"; return 1; }; download_with_progress() { _llmkube_dest="$1"; _llmkube_total="${2:-}"; shift 2; "$@" & _llmkube_pid=$!; _llmkube_elapsed=0; while kill -0 "$_llmkube_pid" 2>/dev/null; do sleep 1; kill -0 "$_llmkube_pid" 2>/dev/null || break; _llmkube_elapsed=$((_llmkube_elapsed + 1)); [ $((_llmkube_elapsed % ${PROGRESS_INTERVAL:-10})) -eq 0 ] || continue; _llmkube_have=$(stat -c %s "$_llmkube_dest" 2>/dev/null || echo 0); if [ -n "$_llmkube_total" ] && [ "$_llmkube_total" -gt 0 ] 2>/dev/null; then echo "Downloaded $((_llmkube_have / 1048576)) MiB of $((_llmkube_total / 1048576)) MiB ($((_llmkube_have * 100 / _llmkube_total))%)"; else echo "Downloaded $((_llmkube_have / 1048576)) MiB"; fi; done; wait "$_llmkube_pid"; } && mkdir -p /models && llmkube_prepare_download() { mkdir -p "$(dirname "$dest")"; }; llmkube_cached_size_matches() { _llmkube_local_size=$(stat -c %s "$dest" 2>/dev/null) || return 1; if [ -f "$dest.llmkube-size" ]; then _llmkube_size=$(cat "$dest.llmkube-size" 2>/dev/null); case "$_llmkube_size" in ''|*[!0-9]*) ;; *) [ "$_llmkube_local_size" = "$_llmkube_size" ]; return $?;; esac; fi; echo "WARNING: no valid size record for $rel; keeping cached copy without size validation" >&2; if [ "${cache_fs:-}" != 65735546 ]; then llmkube_atomic_write "$dest.llmkube-size" "$_llmkube_local_size" || echo "WARNING: could not record cached size for $rel" >&2; fi; return 0; }; normalize_hf_source() { case "$1" in hf://*) src="${1#hf://}"; rev="${src#*@}"; if [ "$rev" != "$src" ]; then echo "https://huggingface.co/${src%%@*}/resolve/$rev/"; else echo "https://huggingface.co/$src/resolve/main/"; fi ;; *) echo "$1" ;; esac; } && SOURCE="$(normalize_hf_source "$MODEL_SOURCE")" && printf '%s\n' "$MODEL_FILES" | while IFS= read -r rel; do [ -n "$rel" ] || continue; dest="$CACHE_DIR/$rel"; url="${SOURCE%/}/$rel"; if [ -f "$dest" ] && llmkube_cached_size_matches; then echo "Model artifact $rel already cached, skipping download"; else llmkube_prepare_download || exit 1; echo "Downloading model artifact $rel..."; MODEL_PATH="$dest"; MODEL_SOURCE="$url"; remote_head=$(curl -fsSL -I "$MODEL_SOURCE" -o /dev/null -w 'CL%header{content-length}ET%header{etag}\n%header{accept-ranges}' 2>/dev/null || echo ''); remote_validator=$(printf '%s\n' "$remote_head" | sed -n 1p); accept_ranges=$(printf '%s\n' "$remote_head" | sed -n 2p); remote_size=${remote_validator#CL}; remote_size=${remote_size%%ET*}; key=$(printf '%s' "$remote_validator" | sha256sum | cut -c1-12); MODEL_PARTIAL="$MODEL_PATH.$key.tmp"; find "$(dirname "$MODEL_PATH")" -maxdepth 1 -name '*.tmp' ! -name "$(basename "$MODEL_PARTIAL")" -delete; [ "$accept_ranges" = bytes ] || rm -f "$MODEL_PARTIAL"; download_with_progress "$MODEL_PARTIAL" "$remote_size" curl -f -L -C - -o "$MODEL_PARTIAL" "$url" --no-progress-meter && case "$remote_size" in ''|0) ;; *) if [ "$(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0)" != "$remote_size" ]; then echo "ERROR: $MODEL_PARTIAL is $(stat -c %s "$MODEL_PARTIAL" 2>/dev/null || echo 0) bytes but the origin advertised $remote_size; discarded it" >&2; rm -f "$MODEL_PARTIAL"; false; fi;; esac && { published_size=$(stat -c %s "$MODEL_PARTIAL") && mv "$MODEL_PARTIAL" "$dest" && { [ "$(stat -c %s "$dest")" = "$published_size" ] || { rm -f "$dest" "$dest.sha256" "$dest.llmkube-size"; echo "ERROR: published artifact $rel has the wrong size" >&2; false; }; } && { llmkube_atomic_write "$dest.llmkube-size" "$published_size" || echo "WARNING: could not record staged size for $rel" >&2; }; } || { echo "ERROR: failed to download $rel"; exit 1; }; fi; done && find /models -name '*.tmp' -delete