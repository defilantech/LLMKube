if [ ! -f "$MODEL_PATH" ]; then echo 'Downloading model from S3...'; download_with_progress() { _llmkube_dest="$1"; _llmkube_total="${2:-}"; shift 2; "$@" & _llmkube_pid=$!; _llmkube_tenths=0; while kill -0 "$_llmkube_pid" 2>/dev/null; do if sleep 0.1 2>/dev/null; then _llmkube_tenths=$((_llmkube_tenths + 1)); else sleep 1; _llmkube_tenths=$((_llmkube_tenths + 10)); fi; _llmkube_elapsed=$((_llmkube_tenths / 10)); if [ "$_llmkube_tenths" -ge 10 ] && [ $((_llmkube_tenths % 10)) -eq 0 ] && [ $((_llmkube_elapsed % ${PROGRESS_INTERVAL:-10})) -eq 0 ]; then _llmkube_have=$(stat -c %s "$_llmkube_dest" 2>/dev/null || echo 0); if [ -n "$_llmkube_total" ] && [ "$_llmkube_total" -gt 0 ] 2>/dev/null; then echo "Downloaded $((_llmkube_have / 1048576)) MiB of $((_llmkube_total / 1048576)) MiB ($((_llmkube_have * 100 / _llmkube_total))%)"; else echo "Downloaded $((_llmkube_have / 1048576)) MiB"; fi; fi; kill -0 "$_llmkube_pid" 2>/dev/null || break; done; wait "$_llmkube_pid"; } && s3_curl() { _llmkube_id=$(printf '%s' "${AWS_ACCESS_KEY_ID:-}"); _llmkube_key=$(printf '%s' "${AWS_SECRET_ACCESS_KEY:-}"); case "${_llmkube_id}${_llmkube_key}" in *'"'*|*'\'*|*[![:print:]]*) echo "ERROR: AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY contains a character curl config cannot carry" >&2; return 1;; esac; printf 'user = "%s:%s"\n' "$_llmkube_id" "$_llmkube_key" | curl --aws-sigv4 "aws:amz:${AWS_REGION}:s3" -K - "$@"; } && download_with_progress "$MODEL_PATH.tmp" "" s3_curl -f -L -o "$MODEL_PATH.tmp" "${AWS_ENDPOINT_URL}/${S3_BUCKET}/${S3_KEY}" --no-progress-meter && mv "$MODEL_PATH.tmp" "$MODEL_PATH" && echo 'Model downloaded successfully'; else echo 'Model already exists, skipping download'; fi